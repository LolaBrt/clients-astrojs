---
import SignIn from "../../node_modules/auth-astro/src/components/SignIn.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Connexion">
  <div class="login-page">
    <div class="login-card">
      <div class="brand-icon">📍</div>
      <h1>Connexion</h1>
      <p>Accédez à votre tableau de bord clients.</p>

      <SignIn provider="google" class="login-button">
        Se connecter avec Google
      </SignIn>
    </div>
  </div>
</Layout>
